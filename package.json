{
  "name": "solform",
  "version": "1.1.0",
  "description": "Easily manage forms in SolidJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragokan/solform.git"
  },
  "keywords": [
    "forms",
    "solform",
    "solidjs forms",
    "solid forms"
  ],
  "author": "ragokan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ragokan/solform/issues"
  },
  "homepage": "https://github.com/ragokan/solform#readme",
  "peerDependencies": {
    "solid-js": ">=1.6.0 <2.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "solid-js": "^1.9.0",
    "tslib": "^2.8.1",
    "typescript": "^5.5.4"
  }
}
